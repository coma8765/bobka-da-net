      {
        "name": "warehouse",
        "label": "Склад",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "supply-lab-postgres"
        },
        "definition": "SELECT label AS __text, value AS __value\nFROM (\n    SELECT 'Все склады'::text AS label, '-1'::text AS value, 0 AS ordering\n    UNION ALL\n    SELECT code || ' — ' || name, warehouse_id::text, 1\n    FROM public.warehouses\n) AS options\nORDER BY ordering, label;",
        "query": "SELECT label AS __text, value AS __value\nFROM (\n    SELECT 'Все склады'::text AS label, '-1'::text AS value, 0 AS ordering\n    UNION ALL\n    SELECT code || ' — ' || name, warehouse_id::text, 1\n    FROM public.warehouses\n) AS options\nORDER BY ordering, label;",
