      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supply-lab-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * COUNT(*) FILTER (WHERE d.quality_status = 'rejected') / NULLIF(COUNT(*), 0) AS rejected_percent\nFROM public.deliveries d\nWHERE $__timeFilter(d.delivered_at)\n  AND (${warehouse:sqlstring} = '-1'\n       OR d.warehouse_id = CAST(${warehouse:sqlstring} AS bigint));",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
