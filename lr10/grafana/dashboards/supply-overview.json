    {
      "id": 4,
      "title": "Поставки по дням и статусам",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supply-lab-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supply-lab-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', d.delivered_at) AT TIME ZONE 'UTC' AS time,\n       COUNT(*) FILTER (WHERE d.quality_status = 'accepted') AS accepted,\n       COUNT(*) FILTER (WHERE d.quality_status = 'inspection') AS inspection,\n       COUNT(*) FILTER (WHERE d.quality_status = 'rejected') AS rejected\nFROM public.deliveries d\nWHERE $__timeFilter(d.delivered_at)\n  AND (${warehouse:sqlstring} = '-1'\n       OR d.warehouse_id = CAST(${warehouse:sqlstring} AS bigint))\nGROUP BY 1\nORDER BY 1;",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": false,
            "insertNulls": 86400000,
            "axisLabel": "Поставки",
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
