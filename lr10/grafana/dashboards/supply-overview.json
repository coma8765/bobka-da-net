          "sort": "none"
        },
        "xTickLabelMaxLength": 24
      },
      "description": "Условные денежные единицы, все статусы. Склады вне топ-10 не показаны."
    },
    {
      "id": 6,
      "title": "Последние поставки за период — до 100 строк",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supply-lab-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supply-lab-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT d.delivery_id, d.delivered_at, d.batch_number,\n       s.name AS supplier, p.sku, p.name AS product,\n       w.code AS warehouse_code, w.name AS warehouse,\n       d.quantity, p.unit, d.unit_cost,\n       d.quantity * d.unit_cost AS total_cost,\n       d.quality_status, d.expires_on\nFROM public.deliveries d\nJOIN public.suppliers s ON s.supplier_id = d.supplier_id\nJOIN public.products p ON p.product_id = d.product_id\nJOIN public.warehouses w ON w.warehouse_id = d.warehouse_id\nWHERE $__timeFilter(d.delivered_at)\n  AND (${warehouse:sqlstring} = '-1'\n       OR d.warehouse_id = CAST(${warehouse:sqlstring} AS bigint))\nORDER BY d.delivered_at DESC, d.delivery_id DESC\nLIMIT 100;",
