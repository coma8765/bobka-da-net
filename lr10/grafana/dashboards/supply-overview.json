    {
      "id": 5,
      "title": "Топ-10 складов по стоимости партий",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supply-lab-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supply-lab-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT w.code || ' — ' || w.name AS warehouse,\n       SUM(d.quantity * d.unit_cost) AS total_cost\nFROM public.deliveries d\nJOIN public.warehouses w ON w.warehouse_id = d.warehouse_id\nWHERE $__timeFilter(d.delivered_at)\n  AND (${warehouse:sqlstring} = '-1'\n       OR d.warehouse_id = CAST(${warehouse:sqlstring} AS bigint))\nGROUP BY w.warehouse_id, w.code, w.name\nORDER BY total_cost DESC, w.warehouse_id\nLIMIT 10;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
