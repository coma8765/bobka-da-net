  "panels": [
    {
      "id": 1,
      "title": "Количество поставок",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supply-lab-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supply-lab-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS delivery_count\nFROM public.deliveries d\nWHERE $__timeFilter(d.delivered_at)\n  AND (${warehouse:sqlstring} = '-1'\n       OR d.warehouse_id = CAST(${warehouse:sqlstring} AS bigint));",
          "format": "table"
        }
      ],
